{
    # Глобальные настройки
    email ujin_slav@mail.ru          # для Let's Encrypt
}

# Главный сайт или wildcard
ujinslav.fun {
    reverse_proxy localhost:8080   # сюда frps кидает HTTP-трафик по subdomain'ам
}


mail.ujinslav.fun {
    reverse_proxy localhost:9000{      # ← должен быть 8081!
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up Host {host}
    }
}